import os
import argparse
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM
from datetime import datetime
import re


# -------------------------------
# Helper functions
# -------------------------------

def slugify(text):
    text = text.lower().strip()
    text = re.sub(r"[^a-z0-9]+", "_", text)
    return text[:40].strip("_")


def clean_model_name(model_name):
    # e.g. "Qwen/Qwen2-7B-Instruct" → "Qwen2-7B-Instruct"
    return model_name.split("/")[-1]


# -------------------------------
# Generation function
# -------------------------------

def generate_text(model_name, prompt, max_tokens, temperature, top_p, seed):

    torch.manual_seed(seed)
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[Using device: {device}]")

    print(f"[Loading tokenizer: {model_name}]")
    tokenizer = AutoTokenizer.from_pretrained(model_name)

    print(f"[Loading model: {model_name}]")
    model = AutoModelForCausalLM.from_pretrained(
        model_name,
        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,
    )
    model.to(device)
    print(f"[Model is on → {next(model.parameters()).device}]")

    print("[Encoding prompt]")
    inputs = tokenizer(prompt, return_tensors="pt")
    inputs = {k: v.to(device) for k, v in inputs.items()}

    print("[Generating text...]")
    output = model.generate(
        **inputs,
        max_new_tokens=max_tokens,
        temperature=temperature,
        top_p=top_p,
        do_sample=True,
        pad_token_id=tokenizer.eos_token_id,
    )

    decoded = tokenizer.decode(output[0], skip_special_tokens=True)

    # build metadata-rich filename
    model_clean = clean_model_name(model_name)
    topic_slug = slugify(prompt.split("\n")[0])
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    filename = f"{model_clean}__{max_tokens}t__{topic_slug}__{timestamp}.txt"

    out_dir = "generated_texts_og/Texts"
    os.makedirs(out_dir, exist_ok=True)

    path = os.path.join(out_dir, filename)
    with open(path, "w", encoding="utf-8") as f:
        f.write(decoded)

    print(f"[Saved output → {path}]")
    return path


# -------------------------------
# CLI
# -------------------------------

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--model",
        type=str,
        default="Qwen/Qwen2-7B-Instruct"
    )
    parser.add_argument(
        "--prompt",
        type=str,
        default="Write a long essay about scientific thought."
    )
    parser.add_argument("--tokens", type=int, default=5000)
    parser.add_argument("--temp", type=float, default=1.0)
    parser.add_argument("--top_p", type=float, default=0.95)
    parser.add_argument("--seed", type=int, default=42)

    args = parser.parse_args()

    generate_text(
        model_name=args.model,
        prompt=args.prompt,
        max_tokens=args.tokens,
        temperature=args.temp,
        top_p=args.top_p,
        seed=args.seed,
    )


if __name__ == "__main__":
    main()
